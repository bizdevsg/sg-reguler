# Salin ke .env.local dan isi hanya konfigurasi yang diperlukan.
# Baris yang dikomentari menggunakan default aplikasi saat tidak diatur.
# NEXT_PUBLIC_* tersedia di browser; jangan isi dengan rahasia.
# Untuk produksi di reguler.sg-berjangka.com, atur APP_ENV=prod,
# NEXT_PUBLIC_SITE_URL=https://reguler.sg-berjangka.com,
# SG_ADMIN_REQUEST_ORIGIN=https://reguler.sg-berjangka.com, dan
# NEWS_PORTAL_BASE_URL=https://sg-admin.sg-berjangka.com. Isi SG_ADMIN_API_KEY
# dengan kredensial dari backend. Variabel NEXT_PUBLIC_* harus tersedia saat build.

# Lingkungan dan keamanan API
# APP_ENV=dev
# INTERNAL_API_TOKEN=
# CLIENT_AREA_SESSION_SECRET=
# NEXT_ALLOWED_ORIGINS=
# DEPLOYMENT_VERSION=

# Autentikasi SG Admin (server-side)
SG_ADMIN_REQUEST_ORIGIN=http://localhost:3000
SG_ADMIN_API_KEY=
# CLIENT_AREA_CONFIG_API_TOKEN=

# Endpoint SG Admin dan sumber gambar
# WAKIL_PIALANG_API_BASE_URL=https://sg-admin.sg-berjangka.com/api/v1/wakil-pialang-berjangka
# NEWS_API_URL=
# NEWS_API_URL_ID=
# NEWS_PORTAL_BASE_URL=
# NEWS_IMAGE_BASE_URL=
# PRODUCT_API_URL=
# PRODUCT_PORTAL_BASE_URL=
# EBOOK_CATEGORY_API_URL=
# CLIENT_AREA_CONFIG_API_URL=
# BANNER_API_URL=
# BANNER_DETAIL_API_URL=
# BANNER_IMAGE_BASE_URL=
# PENGHARGAAN_API_URL=
# PENGHARGAAN_IMAGE_BASE_URL=
# PENGUMUMAN_API_URL=
# CONTACT_MESSAGE_API_URL=
# COMPANY_PROFILE_API_URL=
# LEGALITAS_API_URL=
# PRIVACY_POLICY_API_URL=
# TERMS_CONDITIONS_API_URL=
# TRADINGVIEW_SYMBOL_API_URL=
# MARKET_SIGNAL_API_URL=
# MARKET_SIGNAL_IMAGE_BASE_URL=

# Data pasar dan edukasi (token hanya untuk server)
# HISTORICAL_DATA_API_URL=
# HISTORICAL_DATA_API_TOKEN=
# ECONOMIC_CALENDAR_API_BASE_URL=
# ECONOMIC_CALENDAR_API_TOKEN=
# MARKET_ACADEMY_API_URL=
# FRANKFURTER_API_URL=
# NEXT_PUBLIC_LIVE_QUOTE_SOCKET_URL=

# URL publik dan fitur
# NEXT_PUBLIC_MAIN_WEBSITE_URL=https://sg-berjangka.com/
# NEXT_PUBLIC_LOGIN_URL=
# NEXT_PUBLIC_REGISTER_URL=
# NEXT_PUBLIC_SITE_URL=
# NEXT_PUBLIC_CLIENT_SITE_URL=
# NEXT_PUBLIC_HERO_CTA_URL=
# NEXT_PUBLIC_SPREAD_CTA_URL=
# NEXT_PUBLIC_SOLID_GOLD_PLAY_STORE_URL=
# NEXT_PUBLIC_SOLID_GOLD_APP_STORE_URL=
# NEXT_PUBLIC_ENABLE_CLIENT_AREA=false
# NEXT_PUBLIC_FRAMER_IMAGE_BASE_URL=
# NEXT_PUBLIC_PLACEHODER_BASE_URL=
# NEXT_PUBLIC_SOLID_GOLD_IMAGE_BASE_URL=

# WhatsApp dan Tawk
# NEXT_PUBLIC_WHATSAPP_NUMBER=
# NEXT_PUBLIC_ENABLE_TAWK_CHAT=false
# NEXT_PUBLIC_WIDGET_EMBED_URL=

# reCAPTCHA
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=
# RECAPTCHA_MIN_SCORE=0.65

# Firebase (konfigurasi publik)
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# NODE_ENV diatur oleh Next.js; VERCEL diatur oleh platform Vercel.
