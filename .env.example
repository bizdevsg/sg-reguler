# Tambahkan variabel environment project di sini.

# Tujuan tombol "Kembali ke Website Utama" di navbar (default https://sg-berjangka.com/)
NEXT_PUBLIC_MAIN_WEBSITE_URL=https://sg-berjangka.com/

# Sumber data daftar Wakil Pialang dan kategori kantor cabang.
WAKIL_PIALANG_API_BASE_URL=https://sg-admin.sg-berjangka.com/api/v1/wakil-pialang-berjangka

# Kredensial server-side untuk API SG Admin. Jangan gunakan prefix NEXT_PUBLIC_.
SG_ADMIN_REQUEST_ORIGIN=http://localhost:3000
SG_ADMIN_API_KEY=
